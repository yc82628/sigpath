node_modules/
.next/
out/
*.log
next-env.d.ts

# Secrets — never commit
.env
.env.*
!.env.local.example
fee-payer.json
*.pem

# Anchor / Rust
target/
programs/**/target/
.anchor/
test-ledger/

# Bundles
*.zip

# Live-capture test photos (may contain your face)
test-images/*.jpg
test-images/*.jpeg
test-images/*.png

# Delivery addresses for USDC checkout. Encrypted, and deleted after each order
# settles - but a git history is a copy no deletion reaches, so never commit it.
.data/

# Local-validator USDC mint written by scripts/orders-roundtrip.ts --write-mint
usdc-mint.json

# Pitch deck exports: the full deck stays local; the 2-minute deck is published
SigPath-Pitch*.pptx
!SigPath-Pitch-2min.pptx

# TypeScript incremental-build cache: rebuilt on every build, differs per machine
*.tsbuildinfo

# Local Claude Code settings for this machine
.claude/

# Windows screenshots: often capture browser tabs and the taskbar, keep them local
Screenshot *.png
