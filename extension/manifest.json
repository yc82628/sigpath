{
  "manifest_version": 3,
  "name": "SigPath check",
  "version": "0.4.0",
  "description": "Is it a real deal? On Amazon, AliExpress, OTTO, MediaMarkt and Saturn: the price against eBay, red flags, and a better deal if any.",
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png", "default_title": "SigPath check" },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://sigpath.vercel.app/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "sigpath-check@sigpath.vercel.app",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["websiteContent", "browsingActivity"] }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.de/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.nl/*",
        "https://*.aliexpress.com/*",
        "https://www.otto.de/*",
        "https://www.mediamarkt.de/*",
        "https://www.saturn.de/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
