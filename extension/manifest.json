{
  "manifest_version": 3,
  "name": "SigPath check",
  "version": "0.3.0",
  "description": "SigPath's scam and price check on the product page you're looking at: Amazon, AliExpress, OTTO, MediaMarkt, Saturn, or any shop from the menu.",
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png", "default_title": "SigPath check" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://sigpath.vercel.app/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.de/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.nl/*",
        "https://*.aliexpress.com/*",
        "https://www.otto.de/*",
        "https://www.mediamarkt.de/*",
        "https://www.saturn.de/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
