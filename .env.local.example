# Copy to .env.local and fill in. .env.local is gitignored; never commit secrets.

# --- SAFE TO EXPOSE (bundled into client JS) ---
# Anything prefixed NEXT_PUBLIC_ reaches the browser. Non-secrets only.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Printed by `anchor keys sync` / `anchor deploy`. Must be a real base58 program
# id before `next build` — a placeholder here fails the build at PublicKey().
NEXT_PUBLIC_PROGRAM_ID=

# --- SOLANA, SERVER ONLY ---
# Issuer keypair that signs and pays for attestations, as a one-line JSON byte
# array. Generate with:
#   solana-keygen new --outfile issuer.json
#   solana airdrop 2 --keypair issuer.json --url devnet
#   cat issuer.json
ISSUER_SECRET=

# How long an attestation stays fresh, in seconds. Default 90 days. 0 = never.
ATTESTATION_TTL_SECONDS=7776000

# --- BASE (EAS) MIRROR — OFF BY DEFAULT ---
# The Solana path works fully without any of this. Turn on only once you have
# registered a schema and funded an attester wallet.
BASE_ENABLED=false
BASE_RPC_URL=https://sepolia.base.org
# SERVER ONLY — EVM private key that pays for and signs mirror attestations.
BASE_ATTESTER_SECRET=
# UID from registering EAS_SCHEMA once. See README "Enabling Base".
EAS_SCHEMA_UID=
# OP Stack predeploy; override only for a network where it differs.
# EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021

# SAFE TO EXPOSE — which EAS explorer to link to.
#   https://base-sepolia.easscan.org (testnet) | https://base.easscan.org (mainnet)
NEXT_PUBLIC_EAS_EXPLORER=https://base-sepolia.easscan.org

# --- LIVE CAPTURE (photo challenge) ---
# Liveness provider.
#   mock    (default) always passes and detects nothing — the demo stub.
#   vision  verifies the capture challenge with Claude vision: the model checks
#           the photo actually satisfies the issued instruction (e.g. handwritten
#           "7K4M" held next to the face). Requires ANTHROPIC_API_KEY.
#           No biometrics are collected, so no face template is stored.
LIVENESS_PROVIDER=mock
# SERVER ONLY. Required when LIVENESS_PROVIDER=vision.
# ANTHROPIC_API_KEY=

# Which model judges the capture photo. Three backends, one shared prompt and
# one shared policy — switching changes WHICH MODEL answers, never the rules.
#
#   anthropic (default) hosted Claude, ~$0.01/check, ~1s. The strongest.
#                       Needs ANTHROPIC_API_KEY with credit.
#   remote              any OpenAI-compatible vision endpoint. NEEDS NO LOCAL
#                       GPU, so this is the one to use on a cloud host or a
#                       laptop without a discrete graphics card.
#   ollama              a model on THIS machine: free, but needs a GPU.
#                       ~2.5s warm, ~48s cold, and it will not load at all in
#                       much under 8GB of VRAM.
#
# A smaller model is weaker at exactly the reads this check depends on — one
# wrong character in a code, handwriting vs print. Re-run scripts/test-photo-
# check.ts against the backend you intend to demo with before trusting it.
VISION_BACKEND=anthropic

# --- VISION_BACKEND=remote ---
# Anything that speaks POST {VISION_API_BASE}/chat/completions: OpenRouter,
# Groq, Together, DeepInfra, Fireworks, a self-hosted vLLM, or Ollama's own /v1
# endpoint on a machine that does have a GPU.
#
#   OpenRouter   VISION_API_BASE=https://openrouter.ai/api/v1
#                VISION_MODEL=qwen/qwen2.5-vl-72b-instruct
#   Groq         VISION_API_BASE=https://api.groq.com/openai/v1
#                VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   remote GPU   VISION_API_BASE=http://your-box:11434/v1  (VISION_API_KEY=ollama)
#
# SERVER ONLY.
# VISION_API_BASE=
# VISION_API_KEY=
# VISION_MODEL=
# Sent as HTTP-Referer / X-Title. OpenRouter shows these on your dashboard;
# every other provider ignores them.
# VISION_API_REFERER=https://sigpath.example
# VISION_API_TITLE=SigPath
# Give a slow or cold-starting host room, but stay under the 90s challenge
# window — a check that outlives the challenge can only ever report expired.
# VISION_TIMEOUT_MS=60000

# --- VISION_BACKEND=ollama ---
# OLLAMA_VISION_MODEL=qwen2.5vl:7b
# OLLAMA_HOST=http://localhost:11434

# --- SOLANA ATTESTATION SERVICE (portable credential) ---
# Issues a SAS attestation alongside SigPath's own record, so any Solana app can
# read a verification without integrating with SigPath. Off by default; the
# SigPath write never depends on it.
# Register the credential and schema once per cluster:
#   SAS_ENABLED=true npx tsx scripts/sas-bootstrap.ts
SAS_ENABLED=false
# Defaults to NEXT_PUBLIC_RPC_URL with http->ws. Override for a custom endpoint.
# SOLANA_WS_URL=

# --- MARKETPLACE SEARCH ---
# eBay Browse API. APPLICATION credentials (client-credentials grant), not a
# user login — which is what lets the search work on a site with no accounts.
# Register at https://developer.ebay.com, create a keyset, paste it here.
# Until these are set the source reports `not_configured`: the search still
# runs, and the price comparison is scoped to the sources that did answer.
# SERVER ONLY.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# Which eBay site to search. EBAY_DE is the default.
# EBAY_MARKETPLACE_ID=EBAY_DE
# sandbox | production (default).
#
# A PRODUCTION keyset is created DISABLED and stays that way until you complete
# the marketplace account deletion notification step on the Application Keys
# page. A SANDBOX keyset has no such gate and works immediately — use it to
# prove the integration while production clearance is pending.
#
# Sandbox returns eBay test inventory, not real listings, so its prices are not
# market data. Never demo a price comparison from sandbox results.
# Verify either with:  npx tsx scripts/ebay-check.ts "thinkpad x1"
# EBAY_ENV=sandbox
#
# The account-deletion step: SigPath stores eBay usernames (order sellers,
# reports, badges), so it subscribes rather than claiming the "no eBay data"
# exemption. /api/ebay/account-deletion answers eBay's challenge and, on a
# SIGNED notice, removes or pseudonymises that user's records. It needs a
# public https address: run
#   npx tsx scripts/ebay-deletion-setup.ts https://your-site.example
# which writes both values below and prints what to enter in eBay's portal.
# The route is off (503) until both are set.
# EBAY_DELETION_ENDPOINT=https://your-site.example/api/ebay/account-deletion
# EBAY_VERIFICATION_TOKEN=

# The offline feed in lib/marketplace/sources/stub.ts, so the search route is
# demonstrable with no credentials at all. Deterministic per query, and it
# deliberately contains a scam listing and a duplicated photo so the detections
# have something to catch. Set to false once real sources are configured.
STUB_FEED=true
# Make the demo feed answer after this many milliseconds, like a real
# marketplace, to show the search page streaming results in. Max 10000.
# STUB_DELAY_MS=2500

# LINK-OUTS ONLY, ON PURPOSE — no API we may query, so the search page deep
# links into each site's own search instead of extracting anything:
#   idealo        The developer API is for retailers pushing offers IN, not for
#                 reading idealo's search.
#   Kleinanzeigen No public API, terms forbid automated access, and systematic
#                 extraction runs into the German database right (UrhG s.87b).
# Further licensed sources with real APIs: bol.com (Marketing Catalog API, via
# its affiliate programme) and the affiliate feed networks (Awin, CJ) below.

# --- AMAZON ---
# sources/amazon.ts implements Product Advertising API 5.0, which Amazon retired
# in 2026. Its successor, the Creators API, is open only to an Associates
# account with at least 10 qualifying sales in the past 30 days.
#
# Until then, Amazon is a search LINK under "Also search directly", into
# Amazon's own storefront. With AMAZON_PARTNER_TAG set (your Associates tracking
# id, e.g. sigpath-21), the link carries it, so referred purchases count towards
# Creators API access. Tagged links are marked rel="sponsored" and shown with
# Amazon's required disclosure. They never change a verdict or the order of
# results. Sign up at https://partnernet.amazon.de (Germany).
# AMAZON_PARTNER_TAG=
#
# The retired PA-API keys, kept for sources/amazon.ts. SERVER ONLY.
# AMAZON_ACCESS_KEY=
# AMAZON_SECRET_KEY=
# Which Amazon site. DE (default), UK, FR, US.
# AMAZON_LOCALE=DE

# --- ETSY (Open API v3) ---
# Independent sellers, the closest open-API match to eBay's model. Needs only an
# APPLICATION key — no user OAuth — so it fits a site with no accounts.
# Register an app at https://www.etsy.com/developers/register and copy the
# keystring and shared secret from "Your apps". Etsy v3 requires BOTH, sent as
# "keystring:shared_secret"; the keystring alone is rejected.
#
# Etsy listings are shown but kept OUT of the price comparison: handmade and
# vintage goods are not comparable with retail, and pooling them would flag
# every cheap handmade item as "below the median".
# SERVER ONLY.
# ETSY_KEYSTRING=
# ETSY_SHARED_SECRET=

# --- AFFILIATE PRODUCT FEED (many merchants, one integration) ---
# The legitimate route to retailers that have no public search API. Affiliate
# networks license publishers to read and display merchant product data:
#   Awin          Create-a-Feed / ProductServe  (~200M products)
#   CJ            product feeds
#   Tradedoubler  product feeds
# Any delimited feed with a header row works — Awin CSV, a Google Shopping
# feed, or a plain merchant export. Column names are auto-detected from the
# usual candidates; see lib/marketplace/sources/feed.ts.
#
# A feed is a periodic SNAPSHOT, not a live index. Its prices lag reality, and
# the source says so in every result rather than passing them off as current.
#
# Local file or https URL.
# FEED_URL=./data/awin-feed.csv
# FEED_LABEL=Awin merchants
# FEED_DELIMITER=,
# FEED_CURRENCY=EUR
# Feeds are large; these bound memory and refetching.
# FEED_MAX_ROWS=50000
# FEED_CACHE_MS=900000
# FEED_STALE_MS=172800000
#
# NOTE: this does NOT reach Kleinanzeigen. It is a classifieds site for private
# sellers, not a merchant with an affiliate feed, so it stays a link-out.

# --- USDC CHECKOUT (pay on SigPath, escrowed on Solana) ---
# Both secrets are required; without either, no listing shows a pay button.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"      # QUOTE_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # ADDRESS_KEY
#
# SERVER ONLY. Signs each listing's price so the browser cannot edit it.
# QUOTE_SECRET=
# SERVER ONLY. AES-256 key for delivery addresses at rest. Losing or rotating
# it makes stored addresses unreadable — orders already paid would have nowhere
# to ship. Addresses are deleted when an order is fulfilled or refunded, and
# never kept past 31 days.
# ADDRESS_KEY=
#
# BUYING USDC (MoonPay). When a shopper's wallet is short, the checkout offers
# "Buy USDC with MoonPay": MoonPay's own page, pre-filled with USDC on Solana,
# the missing amount, euros and the shopper's wallet. MoonPay takes the payment
# and does the identity checks; SigPath never sees either. The link is signed
# server-side with the secret key (a pre-filled wallet must be).
# Keys from dashboard.moonpay.com (Developers). TEST keys (pk_test_/sk_test_,
# MoonPay's sandbox, no real money) on devnet; LIVE keys are refused unless the
# escrow is on mainnet, since MoonPay delivers real, mainnet USDC.
# MOONPAY_PUBLISHABLE_KEY=pk_test_...
# SERVER ONLY.
# MOONPAY_SECRET_KEY=sk_test_...
# MoonPay's code for USDC on Solana. Default usdc_sol.
# MOONPAY_CURRENCY_CODE=usdc_sol
#
# WHERE ENCRYPTED RECORDS LIVE (addresses, who-sold-this, pending reports)
# A shared database is required on Vercel: its disk is temporary and per
# instance, so a file written at checkout is gone (or elsewhere) by the time the
# operator looks. Create an Upstash Redis database from Vercel (Storage), connect
# it to the project, and copy its REST URL and token here so the operator tools
# on your machine see the same orders. The database only ever holds ciphertext,
# and every record expires at its retention limit on its own.
# Prove it with:  npx tsx scripts/kv-check.ts
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.)
#
# Without a database, records are files. Gitignored. Default: ./.data/checkout
# (Setting this forces files even when a database is configured.)
# ADDRESS_STORE_DIR=
# Used only if the live ECB rate (api.frankfurter.dev) is unavailable. The
# checkout says when it is using this.
# EUR_USD_RATE=1.1367
# How long SigPath has to buy and ship before the refund opens. Default 7 days.
# CHECKOUT_WINDOW_SECS=604800
# RPC for the orders program. Defaults to NEXT_PUBLIC_RPC_URL. Point at
# http://127.0.0.1:8899 to use a local validator.
# ORDERS_RPC_URL=

# --- FAKE-PRODUCT REPORTS ---
# Uses ADDRESS_KEY (above) to encrypt pending reports and the "who sold this"
# order records; each store binds its own purpose into the encryption, so a
# record cannot be read out of the wrong store even under the same key.
# Upheld reports publish to SAS, so SAS_ENABLED=true is needed to uphold.
# Defaults shown; all under the gitignored ./.data directory.
# REPORT_STORE_DIR=./.data/reports/pending
# REPORT_DECISIONS_FILE=./.data/reports/decisions.json
# ORDER_META_DIR=./.data/order-meta
# REPORT_CASES_FILE=./.data/reports/cases.json
# Where seller-reply links in notices point. Set to the deployed site's URL.
# Seller links are signed with QUOTE_SECRET (domain-separated from quotes).
# PUBLIC_BASE_URL=http://localhost:3000

# --- Verified sellers (/seller/verify) ---------------------------------------
# Claims are signed with QUOTE_SECRET (their own domain strings). Badges are
# issued and burned on SAS, so SAS_ENABLED=true is needed; register and
# tokenize the schema once with `npx tsx scripts/reports-admin.ts bootstrap`.
# eBay/Etsy credentials above are what let a seller prove a listing is theirs.
# Default shown; under the gitignored ./.data directory.
# VERIFIED_SELLERS_FILE=./.data/sellers/verified.json
# Verified businesses (/seller/business): VAT numbers are checked against the
# EU's public VIES register (no key needed); website proofs use QUOTE_SECRET.
# BUSINESSES_FILE=./.data/sellers/businesses.json

# --- Price-drop alerts ---------------------------------------------------------
# Web Push keys. Generate with `npx tsx scripts/vapid-keys.ts` (appends both;
# prints only the public one). Replacing them breaks every existing alert.
# Alerts are offered only when these are set.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# A contact push services can reach about your pushes: mailto: or https URL.
# VAPID_SUBJECT=mailto:you@example.com
# For a hosted scheduler: POST /api/alerts/run with "Authorization: Bearer <this>".
# 32+ characters; without it the route does nothing.
# ALERTS_CRON_SECRET=
# Default shown; under the gitignored ./.data directory.
# ALERTS_FILE=./.data/alerts/watches.json

# --- AI agents: paid deal check through pay.sh (/agents, paysh/sigpath.yaml) ---
# Shared by the pay.sh gateway and this site. Set, /api/check only answers
# requests the gateway forwards (i.e. paid ones); unset, it is open, which is
# fine for local development and the sandbox demo. 32+ random characters,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
# SIGPATH_GATEWAY_KEY=

# --- Ai-chan, the shopping assistant (the "Ask Ai-chan" chat) ---
# Which model answers. The chat button only appears when one is configured.
# Each shopper turn is one to four model calls, limited to 20 turns per 10
# minutes per client. Chats are never stored or logged.
#
#   ollama     A model on this machine (or a GPU box): free, offline, no account.
#              Needs a tool-capable model: `ollama pull qwen2.5:7b` (4.7 GB, fits
#              an 8 GB GPU). Uses OLLAMA_HOST (above) or http://localhost:11434.
#   openai     Any OpenAI-compatible API: Google Gemini (free tier), OpenAI,
#              OpenRouter. Set ASSISTANT_BASE_URL and ASSISTANT_API_KEY, e.g. Gemini:
#              https://generativelanguage.googleapis.com/v1beta/openai
#              with ASSISTANT_MODEL=gemini-3.5-flash (what the live demo uses).
#   anthropic  Claude, with ANTHROPIC_API_KEY (needs API credit, which is separate
#              from a Claude app plan). The default when only that key is set.
# ASSISTANT_PROVIDER=ollama
# Defaults: qwen2.5:7b (ollama), claude-opus-5-5 (anthropic). Required for openai.
# ASSISTANT_MODEL=
# ASSISTANT_BASE_URL=
# ASSISTANT_API_KEY=
